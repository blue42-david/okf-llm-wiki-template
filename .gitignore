# Obsidian: allowlist. Everything in .obsidian/ is ignored unless listed here.
# Plugins: share only their settings (data.json). Each device installs the
# plugin itself; code (main.js etc.) stays out of history.
/.obsidian/*
!/.obsidian/app.json
!/.obsidian/appearance.json
!/.obsidian/core-plugins.json
!/.obsidian/community-plugins.json
!/.obsidian/hotkeys.json
!/.obsidian/plugins/
/.obsidian/plugins/*
!/.obsidian/plugins/obsidian-git/
/.obsidian/plugins/obsidian-git/*
!/.obsidian/plugins/obsidian-git/data.json

__pycache__/
